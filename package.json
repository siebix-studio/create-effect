{
  "name": "effect-scaffold",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "effect": "^4.1.7",
      "@effect/platform-bun": "^4.1.7",
      "@effect/platform-node": "^4.1.7",
      "@effect/platform-browser": "^4.1.7",
      "@effect/vitest": "^4.1.7",
      "vitest": "^5.1.2",
      "alchemy": "^2.0.0-beta.87",
      "@alchemy.run/cloudflare": "^2.0.0-beta.87",
      "@alchemy.run/frontend-frameworks": "^2.0.0-beta.87",
      "@alchemy.run/github": "^2.0.0-beta.87",
      "@alchemy.run/test": "^2.0.0-beta.87",
      "@alchemy.run/neon": "^2.0.0-beta.87",
      "@alchemy.run/sql": "^2.0.0-beta.87",
      "@effect/sql-pg": "^4.1.7",
      "pg": "^8.23.1",
      "foldkit": "0.171.0",
      "@foldkit/devtools": "0.171.0",
      "@foldkit/devtools-mcp": "0.26.0",
      "@foldkit/markdown": "0.15.1",
      "@foldkit/oxlint-plugin": "0.15.4",
      "@foldkit/vite-plugin": "0.29.1",
      "vite": "^8.4.0",
      "tailwindcss": "^4.3.5",
      "@tailwindcss/vite": "^4.3.5",
      "happy-dom": "^21.0.4",
      "@fontsource-variable/geist": "^5.3.0",
      "@fontsource-variable/geist-mono": "^5.3.0",
      "@fontsource-variable/geist-pixel": "^5.3.1",
      "@fontsource/geist": "^5.3.0",
      "@fontsource/geist-mono": "^5.3.0",
      "@fontsource/geist-pixel": "^5.3.0",
      "satori": "^0.63.2",
      "@resvg/resvg-js": "^2.6.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "cli": "DO_NOT_TRACK=1 bun apps/cli/src/bin.ts",
    "test": "bun --filter './apps/*' test && vitest run",
    "typecheck": "tsc --noEmit && bun --filter './apps/*' typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "scripts/release.sh",
    "prepare": "lefthook install && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@alchemy.run/github": "catalog:",
    "@alchemy.run/test": "catalog:",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.73.7",
    "@effect/vitest": "catalog:",
    "@foldkit/oxlint-plugin": "catalog:",
    "@types/bun": "latest",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "lefthook": "^2.2.4",
    "oxfmt": "^0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2",
    "ultracite": "8.3.1",
    "vitest": "catalog:"
  }
}
