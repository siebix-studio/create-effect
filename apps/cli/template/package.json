{
  "name": "{{name}}",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "^4.1.4",
      "@effect/platform-bun": "^4.1.4",
      "@effect/platform-node": "^4.1.4",
      "@effect/platform-browser": "^4.1.4",
      "@effect/vitest": "^4.1.4",
      "vitest": "^5.1.0",
      "alchemy": "^2.0.0-beta.87",
      "@alchemy.run/cloudflare": "^2.0.0-beta.87",
      "@alchemy.run/frontend-frameworks": "^2.0.0-beta.87",
      "@alchemy.run/test": "^2.0.0-beta.87",
      "foldkit": "0.170.0",
      "@foldkit/devtools": "0.170.0",
      "@foldkit/oxlint-plugin": "0.15.4",
      "@foldkit/vite-plugin": "0.29.0",
      "vite": "^8.3.8",
      "tailwindcss": "^4.3.5",
      "@tailwindcss/vite": "^4.3.5",
      "happy-dom": "^21.0.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "test": "bun --filter './apps/*' test && vitest run",
    "typecheck": "tsc --noEmit && bun --filter './apps/*' --filter './packages/*' typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "effect-tsgo patch --typescript --oxlint && (git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true)"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@alchemy.run/test": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "catalog:",
    "@foldkit/oxlint-plugin": "catalog:",
    "@types/bun": "latest",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "ultracite": "8.2.1",
    "vitest": "catalog:"
  }
}
