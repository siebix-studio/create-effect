{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "plugins": [
      {
        "name": "@effect/language-service",
        // Effect diagnostics are reported by Oxlint; keep the LSP for refactors,
        // quickinfo and completions so they don't show up twice.
        "diagnostics": false,
        // Effect's HTTP modules and test helpers are marked unstable; this app builds on them knowingly.
        "allowedUnstableApis": [
          "@effect/vitest",
          "effect/http",
          "effect/http-api"
        ]
      }
    ]
  },
  // The Alchemy stack at the root, and any further stacks in stacks/. Each app and package has
  // its own tsconfig.
  "include": ["*.ts", "stacks", "test"]
}
