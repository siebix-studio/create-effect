{
  "name": "@siebix/create-effect",
  "version": "0.0.0",
  "private": true,
  "description": "Scaffold full-stack Effect apps on Cloudflare, deployed with Alchemy.",
  "license": "MIT",
  "repository": {
    "type": "git",
