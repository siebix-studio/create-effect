{
  "name": "@siebix/create-effect",
  "version": "0.3.0",
  "description": "Create a full-stack Effect app on Cloudflare with one command: an Effect HTTP API, a Foldkit website and the typed contract they share, deployed with Alchemy.",
  "keywords": [
    "alchemy",
    "bun",
    "cli",
    "cloudflare",
    "cloudflare-workers",
    "create",
    "effect",
    "effect-ts",
    "foldkit",
    "full-stack",
    "scaffold",
    "starter",
    "template",
    "typescript"
  ],
  "homepage": "https://effect.siebix.com",
  "bugs": {
    "url": "https://github.com/siebix-studio/create-effect/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Siebix",
    "url": "https://siebix.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siebix-studio/create-effect.git",
    "directory": "apps/cli"
  },
  "bin": {
    "create-effect": "./src/bin.ts"
  },
  "files": [
    "src",
    "template",
    "overlays"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vitest": "catalog:"
  }
}
